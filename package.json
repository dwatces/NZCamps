{
  "name": "nzcamps",
  "version": "1.0.0",
  "description": "Campground reviews for New Zealand: Express, EJS, MongoDB and Passport",
  "main": "index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:bundle": "node scripts/check-bundle.js",
    "vendor": "node scripts/vendor.js"
  },
  "keywords": [
    "camping",
    "campgrounds",
    "new-zealand",
    "reviews",
    "express",
    "ejs",
    "mongodb",
    "mongoose",
    "passport",
    "leaflet"
  ],
  "author": "Daniel Olliver",
  "license": "ISC",
  "config": {
    "mongodbMemoryServer": {
      "version": "8.2.6",
      "disablePostinstall": "1"
    }
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "joi": "^17.13.8",
    "method-override": "^3.0.0",
    "mongoose": "^8.24.5",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/nft": "^1.11.0",
    "bootstrap": "5.3.8",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}

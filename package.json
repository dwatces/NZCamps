    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^10.0.0",
    "ejs": "^3.1.6",
    "ejs-mate": "^3.0.0",
    "express": "^4.17.1",
    "express-mongo-sanitize": "^2.1.0",
    "express-session": "^1.17.2",
    "helmet": "^4.6.0",
    "joi": "^17.4.1",
    "method-override": "^3.0.0",
    "mongoose": "^8.9.0",
    "multer": "^1.4.2",
    "opencage-api-client": "^1.0.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0",
    "sanitize-html": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/nft": "^1.11.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }

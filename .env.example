# Copy to .env for local development. .env is read only when NODE_ENV is not
# "production" (Node's built-in loader); variables already set win. Never
# commit .env. Every variable is optional for a local demo-mode run.

# MongoDB connection string. Without it the app runs in demo mode (sample camps, no saving).
DB_URL=mongodb://127.0.0.1:27017/nzcamps

# Signs the session cookie. Set a long random value anywhere real people log in.
SECRET=replace-with-a-long-random-string

# Geocoding: OpenCage when set, otherwise the keyless OpenStreetMap Nominatim API.
OPENCAGE_ACCESS_TOKEN=

# Photo storage: all three set means uploads go to Cloudinary; otherwise photos are
# stored in the camp document as data URIs.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# Public address, used only for absolute URLs (the canonical link). Navigation links are
# always relative. Without it the address comes from the request.
BASE_URL=

# Port for npm start (default 3000).
PORT=3000

# "production" on Vercel. Anything else loads this file and shows error details.
NODE_ENV=development

# Scripts only (seeds/seedAtlas.js):
# Password for the seed account "ranger"; a random one is printed if unset.
SEED_PASSWORD=
# Must be "yes" to seed a database that is not on this machine.
CONFIRM_REMOTE=

<% layout('layouts/boilerplate')%>

<div class="container d-flex justify-content-center align-items-center">
  <div class="row">
    <div class="col-sm-6 offset-sm-3 col-md-6 offset-md-3 col-xl-5 offset-xl-4">
      <div class="card shadow mt-5">
        <img
          src="/images/auth-ferns-480.jpg"
          srcset="/images/auth-ferns-480.jpg 480w, /images/auth-ferns-960.jpg 960w"
          sizes="(min-width: 1200px) 520px, (min-width: 576px) 50vw, 100vw"
          width="480"
          height="320"
          alt=""
          class="card-img-top"
        />
        <div class="card-body">
          <h4 class="card-title text-center">Login</h4>
          <form action="/login" method="POST" class="validForm" novalidate>
            <div class="mb-3">
              <label class="form-label" for="username">Username</label>
              <input
                class="form-control"
                type="text"
                id="username"
                name="username"
                autofocus
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label" for="password">Password</label>
              <input
                class="form-control"
                type="password"
                id="password"
                name="password"
                required
              />
            </div>
            <button class="btn btn-success btn-large btn-block">Login</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% layout('layouts/boilerplate')%>

<div class="container d-flex justify-content-center align-items-center">
  <div class="row">
    <div class="col-sm-6 offset-sm-3 col-md-6 offset-md-3 col-xl-5 offset-xl-4">
      <div class="card shadow mt-5">
        <% const ferns = imageSet("auth"); %>
        <picture>
          <source type="image/avif" srcset="<%= ferns.avif %>" sizes="(min-width: 576px) 30rem, 100vw" />
          <img
            src="/images/auth-ferns-480.jpg"
            srcset="<%= ferns.jpeg %>"
            sizes="(min-width: 576px) 30rem, 100vw"
            width="480"
            height="320"
            alt=""
            class="card-img-top"
          />
        </picture>
        <div class="card-body">
          <h1 class="h4 card-title text-center">Log in</h1>
          <% const back = typeof returnTo === "string" && returnTo ? returnTo : ""; %>
          <form action="/login" method="POST" class="validForm" novalidate>
            <% if (back) { %>
            <input type="hidden" name="returnTo" value="<%= back %>" />
            <% } %>
            <div class="mb-3">
              <label class="form-label" for="username">Username</label>
              <input
                class="form-control"
                type="text"
                id="username"
                name="username"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                autofocus
                required
                data-field="username"
                data-error="Enter your username."
              />
              <%- include('../partials/fieldError', { name: 'username' }) %>
            </div>

            <div class="mb-3">
              <label class="form-label" for="password">Password</label>
              <input
                class="form-control"
                type="password"
                id="password"
                name="password"
                autocomplete="current-password"
                required
                data-field="password"
                data-error="Enter your password."
              />
              <%- include('../partials/fieldError', { name: 'password' }) %>
            </div>
            <button class="btn btn-primary w-100">Log in</button>
          </form>
          <p class="mt-3 mb-0 text-center">New here? <a href="/register<%= back ? '?returnTo=' + encodeURIComponent(back) : '' %>">Sign up</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

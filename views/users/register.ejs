<% layout('layouts/boilerplate')%>
<div class="container d-flex justify-content-center align-items-center">
  <div class="row">
    <div class="col-sm-6 offset-sm-3 col-md-6 offset-md-3 col-xl-5 offset-xl-4">
      <div class="card shadow mt-5">
        <img
          src="/images/auth-ferns-480.jpg"
          srcset="/images/auth-ferns-480.jpg 480w, /images/auth-ferns-960.jpg 960w"
          sizes="(min-width: 1200px) 520px, (min-width: 576px) 50vw, 100vw"
          width="480"
          height="320"
          alt=""
          class="card-img-top"
        />
        <div class="card-body">
          <h1 class="h4 card-title text-center">Sign up</h1>
          <%- include('../partials/formErrors') %>
          <% const back = typeof returnTo === "string" && returnTo ? returnTo : ""; %>
          <form action="/register" method="post" class="validForm" novalidate>
            <% if (back) { %>
            <input type="hidden" name="returnTo" value="<%= back %>" />
            <% } %>
            <div class="mb-3">
              <label for="username" class="form-label">Username</label>
              <input
                type="text"
                class="form-control<%= invalidClass('username', fieldErrors) %>"
                id="username"
                name="username"
                value="<%= values.username %>"
                minlength="3"
                maxlength="30"
                pattern="[A-Za-z0-9_.\-]+"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                data-field="username"
                data-error="Usernames are 3 to 30 characters: letters, numbers, dots, dashes and underscores."<%- fieldAria('username', fieldErrors, 'username-help') %>
              />
              <div id="username-help" class="form-text">
                3 to 30 characters: letters, numbers, dots, dashes and underscores. Other people see it on your reviews.
              </div>
              <%- include('../partials/fieldError', { name: 'username' }) %>
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">Email</label>
              <input
                type="email"
                class="form-control<%= invalidClass('email', fieldErrors) %>"
                id="email"
                name="email"
                value="<%= values.email %>"
                maxlength="254"
                autocomplete="email"
                required
                data-field="email"
                data-error="Enter a valid email address, like name@example.com."<%- fieldAria('email', fieldErrors, 'email-help') %>
              />
              <div id="email-help" class="form-text">Never shown on the site.</div>
              <%- include('../partials/fieldError', { name: 'email' }) %>
            </div>
            <div class="mb-4">
              <label for="password" class="form-label">Password</label>
              <input
                type="password"
                class="form-control<%= invalidClass('password', fieldErrors) %>"
                id="password"
                name="password"
                minlength="8"
                maxlength="200"
                autocomplete="new-password"
                required
                data-field="password"
                data-error="Choose a password of at least 8 characters."<%- fieldAria('password', fieldErrors, 'password-help') %>
              />
              <div id="password-help" class="form-text">At least 8 characters.</div>
              <%- include('../partials/fieldError', { name: 'password' }) %>
            </div>
            <button class="btn btn-primary w-100">Sign up</button>
          </form>
          <p class="mt-3 mb-0 text-center">Already have an account? <a href="/login<%= back ? '?returnTo=' + encodeURIComponent(back) : '' %>">Log in</a></p>
        </div>
      </div>
    </div>
  </div>
</div>

<!DOCTYPE html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NZ Camps</title>
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <link rel="icon" href="/stylesheets/favicon.ico" type="image/x-icon" />
    <%- block('preload').toString() %>
    <link rel="stylesheet" href="/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/stylesheets/tokens.css" />
    <link rel="stylesheet" href="/stylesheets/app.css" />
    <%- block('styles').toString() %>
  </head>
  <% const bodyClass = block('bodyClass').toString().trim(); %>
  <% const mainClass = block('mainClass').toString().trim(); %>
  <body class="<%= bodyClass || 'has-backdrop' %>">
    <%- include('../partials/navbar') %>
    <% if (typeof demoBanner !== "undefined" && demoBanner) { %>
    <p class="demo-banner mb-0"><%= demoBanner %></p>
    <% } %>
    <main id="main" class="site-main <%= mainClass || 'container mt-5' %>">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
    <%- include('../partials/footer') %>
    <script defer src="/vendor/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <script defer src="/js/forms.js"></script>
    <script defer src="/js/confirm.js"></script>
    <%- block('scripts').toString() %>
  </body>
</html>

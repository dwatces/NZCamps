<!DOCTYPE html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NZ Camps</title>
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <link rel="icon" href="/stylesheets/favicon.ico" type="image/x-icon" />
    <% const preload = block('preload').toString(); %>
    <% if (preload) { %><%- preload %><% } else { %>
    <link rel="preload" as="image" href="/stylesheets/mitchell-luo-CEowgw6VXbE-unsplash.jpg" />
    <link rel="preload" as="image" href="/stylesheets/casey-horner-_aVKjJhFdn0-unsplash.jpg" />
    <% } %>
    <link rel="stylesheet" href="/stylesheets/app.css" />
    <link rel="stylesheet" href="/vendor/bootstrap-5.3.8/css/bootstrap.min.css" />
    <%- block('styles').toString() %>
    <link rel="stylesheet" href="/stylesheets/navbar.css" />
  </head>
  <% const bodyClass = block('bodyClass').toString().trim(); %>
  <% const mainClass = block('mainClass').toString().trim(); %>
  <body class="<%= bodyClass || 'd-flex flex-column background__color__auth' %>">
    <%- include('../partials/navbar') %>
    <main id="main" class="<%= mainClass || 'container mt-5' %>">
      <%- include('../partials/flash') %>
      <%- body %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/vendor/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <script src="/js/forms.js"></script>
    <script src="/js/confirm.js"></script>
    <%- block('scripts').toString() %>
  </body>
</html>

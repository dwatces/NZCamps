<% layout('layouts/boilerplate')%>
<%
  const code = typeof status === "number" ? status : 500;
  const heading = typeof title === "string" && title ? title
    : code === 404 ? "Page not found" : "Something went wrong";
  const detail = typeof message === "string" && message ? message
    : code === 404 ? "There's no page at this address. The link may be wrong, or the page may have been removed."
    : "We couldn't load this page. Please try again in a minute.";
%>
<div class="row">
  <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <div class="card error-panel mt-5">
      <div class="card-body">
        <h1 class="h3 card-title"><%= heading %></h1>
        <p><%= detail %></p>
        <ul class="list-inline mb-0">
          <li class="list-inline-item"><a class="btn btn-success" href="/camps">All camps</a></li>
          <li class="list-inline-item"><a class="btn btn-outline-secondary" href="/">Home</a></li>
        </ul>
        <% if (typeof stack === "string" && stack) { %>
        <pre class="error-stack mt-3 small" tabindex="0"><%= stack %></pre>
        <% } %>
      </div>
    </div>
  </div>
</div>

<% layout('layouts/boilerplate')%>
<div class="row mt-5">
  <h1 class="text-center text-white">Edit camp</h1>
  <div class="col-md-6 offset-md-3">
    <%- include('../partials/formErrors') %>
    <form
      action="/camps/<%=camp._id%>?_method=PUT"
      method="post"
      novalidate
      class="validForm"
      enctype="multipart/form-data"
    >
      <div class="mb-3">
        <label class="form-label text-white" for="title">Camp name</label>
        <input
          class="form-control"
          type="text"
          id="title"
          name="camp[title]"
          value="<%= values.title %>"
          maxlength="100"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label text-white" for="location">Location</label>
        <input
          class="form-control"
          type="text"
          id="location"
          name="camp[location]"
          value="<%= values.location %>"
          maxlength="120"
          required
        />
      </div>
      <div class="mb-3">
        <label class="form-label text-white" for="price">Price per night</label>
        <div class="input-group mb-3">
          <span class="input-group-text" id="price-addon">$</span>
          <input
            type="text"
            id="price"
            class="form-control"
            placeholder="0.00"
            name="camp[price]"
            value="<%= values.price %>"
            inputmode="decimal"
            aria-describedby="price-addon"
            required
          />
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label text-white" for="description">Description</label>
        <textarea
          class="form-control"
          type="text"
          id="description"
          name="camp[description]"
          maxlength="2000"
          required
        ><%= values.description %></textarea>
      </div>
      <% if (camp.images.length) { %>
      <fieldset class="mb-4">
        <legend class="h5 text-center text-white">Tick to Delete</legend>
        <% camp.images.forEach(function(img, i) { %>
        <div class="form-check-inline mb-2">
          <input
            type="checkbox"
            class="form-check-input"
            id="delete-<%= img._id %>"
            name="deleteImages[]"
            value="<%= img._id %>"
          />
          <label class="form-check-label" for="delete-<%= img._id %>">
            <img src="<%= imageUrl(camp, img, 200) %>" class="img-thumbnail" alt="Photo <%= i + 1 %>" />
            <span class="visually-hidden">Delete photo <%= i + 1 %></span>
          </label>
        </div>
        <% }); %>
      </fieldset>
      <% } %>
      <%# The file input is the last field: if a photo is refused, every
          other field has already been read and is shown again. %>
      <div class="mb-3">
        <label class="form-label text-white" for="image">Add photos</label>
        <input
          type="file"
          class="form-control"
          id="image"
          name="image"
          accept="image/jpeg,image/png,image/webp"
          multiple
        />
      </div>
      <div class="mb-3 d-flex justify-content-between">
        <button class="btn btn-success">Save changes</button>
      <a class="btn btn-info btn-fixed" href="/camps/<%= camp._id%>">Back to camp</a>
    </div>
    </form>
  </div>
</div>

<% layout('layouts/boilerplate')%>
<% block('scripts', '<script defer src="/js/upload.js"></script>') %>
<div class="row mt-5">
  <h1 class="text-center text-white">Add a camp</h1>
  <div class="col-md-8 offset-md-2 col-lg-6 offset-lg-3">
    <%- include('../partials/formErrors') %>
    <form
      action="/camps"
      method="post"
      novalidate
      class="validForm"
      enctype="multipart/form-data"
    >
      <%- include('../partials/campFields') %>
      <%- include('../partials/photoInput') %>
      <div class="d-flex justify-content-center mb-5">
        <button class="btn btn-primary">Add camp</button>
      </div>
    </form>
  </div>
</div>

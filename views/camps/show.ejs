<% layout('layouts/boilerplate')%>
<% block('title', camp.title) %>
<% block('description', excerpt(camp.description, 155)) %>
<% block('styles', '<link rel="stylesheet" href="/stylesheets/stars.css" />') %>
<% block('styles', '<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />') %>
<% block('scripts', '<script defer src="/vendor/leaflet-1.9.4/leaflet.js"></script>') %>
<% block('scripts', '<script defer src="/js/campMap.js"></script>') %>

<div class="responsive__column row mt-5">
  <div class="col-lg-6 col-sm-10">
    <% if (!camp.images.length) { %>
    <%- include('../partials/noPhoto') %>
    <% } else { %>
    <div id="campCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <% camp.images.forEach((img, i) => { %>
        <% const credit = photoCredit(img); %>
        <figure class="carousel-item mb-0 <%= i === 0 ? 'active': ''%>">
          <img src="<%= imageUrl(camp, img, 1200) %>" class="d-block w-100" alt="<%= photoAlt(img, camp, i, camp.images.length) %>" />
          <% if (credit) { %>
          <figcaption class="photo-credit">
            Photo: <a href="<%= credit.page %>" rel="noopener"><%= credit.name %></a> on Unsplash
          </figcaption>
          <% } %>
        </figure>
        <% }) %>
      </div>
      <% if(camp.images.length > 1) { %>
      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#campCarousel"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#campCarousel"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
      <% } %>
    </div>
    <% } %>
    <div class="card mt-3 mb-3">
      <div class="card-body">
        <h1 class="h3 card-title"><%= camp.title %></h1>
        <% if (isSample(camp)) { %>
        <p class="mb-2"><span class="badge badge-sample">Sample listing</span></p>
        <% } %>
        <p class="camp-summary mb-2"><%- include('../partials/rating', { camp }) %></p>
        <p class="card-text"><%= camp.description %></p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item"><span class="visually-hidden">Location: </span><%= camp.location %></li>
        <li class="list-group-item"><span class="visually-hidden">Price: </span><%= formatPrice(camp.price) %></li>
        <% const added = createdDate(camp); %>
        <li class="list-group-item">
          <% if (isSample(camp)) { %>
          Added by: Sample listing, not a real campground
          <% } else { %>
          Added by <%= displayName(camp.author) %><% if (added) { %> on <time datetime="<%= isoDate(added) %>"><%= formatDate(added) %></time><% } %>
          <% } %>
        </li>
      </ul>
      <% if(user && sameId(camp.author, user)) { %>
      <div class="card-body d-flex justify-content-between">
        <a class="card-link btn btn-outline-primary" href="/camps/<%=camp._id%>/edit">Edit camp</a>
        <form
          class="d-inline"
          action="/camps/<%=camp._id%>?_method=DELETE"
          method="POST"
          data-confirm="Delete this camp and its reviews? This can't be undone."
        >
          <button class="btn btn-danger">Delete camp</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
  <div class="col-lg-6 col-sm-10">
    <div class="mb-5 card" id="map"></div>
    <% if(user) { %>
    <% const typed = typeof reviewValues !== "undefined" && reviewValues ? reviewValues : {}; %>
    <% const STARS = ["", "Terrible", "Not good", "Average", "Very good", "Amazing"]; %>
    <h2 class="h4 text-white" id="review-form-title">Leave a review</h2>
    <%- include('../partials/formErrors') %>
    <form
      action="/camps/<%=camp._id%>/reviews"
      method="POST"
      class="mb-4 validForm review-form"
      aria-labelledby="review-form-title"
      novalidate
    >
      <fieldset class="mb-3" role="radiogroup"<%- fieldAria('rating', typeof fieldErrors !== "undefined" ? fieldErrors : null) %>>
        <legend class="form-label text-white fs-6 mb-1">Your rating</legend>
        <div class="star__bg">
          <div class="starability-basic">
            <% for (let n = 1; n <= 5; n++) { %>
            <input
              type="radio"
              id="rating-<%= n %>"
              name="review[rating]"
              value="<%= n %>"
              data-field="rating"<%= typed.rating === String(n) ? " checked" : "" %><% if (n === 1) { %>
              required
              data-error="Choose a star rating from 1 to 5."<% } %>
            />
            <label for="rating-<%= n %>" title="<%= STARS[n] %>"><%= n %> star<%= n === 1 ? "" : "s" %>, <%= STARS[n].toLowerCase() %></label>
            <% } %>
          </div>
        </div>
        <%- include('../partials/fieldError', { name: 'rating' }) %>
      </fieldset>
      <div class="mb-3">
        <label class="form-label text-white" for="review-body">Your review</label>
        <textarea
          class="form-control<%= invalidClass('body', typeof fieldErrors !== "undefined" ? fieldErrors : null) %>"
          name="review[body]"
          id="review-body"
          rows="3"
          maxlength="1000"
          required
          data-field="body"
          data-error="Enter your review."<%- fieldAria('body', typeof fieldErrors !== "undefined" ? fieldErrors : null) %>
        ><%= typed.body || "" %></textarea>
        <%- include('../partials/fieldError', { name: 'body' }) %>
      </div>
      <button class="btn btn-primary">Post review</button>
    </form>
    <% } %>
    <h2 class="h4 text-white" id="reviews">Reviews</h2>
    <% if (!user) { %>
    <p class="reviews-prompt">
      <a class="btn btn-primary" href="/login?returnTo=<%= encodeURIComponent('/camps/' + camp._id) %>">Log in to leave a review</a>
    </p>
    <% } %>
    <% if (!camp.reviews.length) { %>
    <div class="reviews-empty">
      <p class="mb-0">No reviews yet. Be the first to leave one.</p>
    </div>
    <% } %>
    <% if (isSample(camp) && camp.reviews.length) { %>
    <p class="sample-note">Reviews on sample listings are test entries.</p>
    <% } %>
    <% for (const review of camp.reviews) { %>
    <% const posted = createdDate(review); %>
    <article class="card mb-3">
      <div class="card-body">
        <h3 class="h6 card-title mb-1"><%= displayName(review.author) %></h3>
        <% if (posted) { %>
        <p class="small text-muted mb-1"><time datetime="<%= isoDate(posted) %>"><%= formatDate(posted) %></time></p>
        <% } %>
        <p class="card-subtitle mb-2 starability-result" data-rating="<%= review.rating %>">
          Rated <%= review.rating %> out of 5
        </p>
        <p class="card-text"><%= review.body %></p>
        <% if(user && sameId(review.author, user)) { %>
        <form
          action="/camps/<%=camp._id%>/reviews/<%=review._id%>?_method=DELETE"
          method="POST"
          data-confirm="Delete your review?"
        >
          <div class="d-flex justify-content-end">
            <button class="btn btn-sm btn-danger">Delete review</button>
          </div>
        </form>
        <% } %>
      </div>
    </article>
    <% } %>
  </div>
</div>

<script type="application/json" id="camp-data"><%- safeJson(mapPoint(camp)) %></script>

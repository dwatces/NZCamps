<% layout('layouts/boilerplate')%>
<% block('styles', '<link rel="stylesheet" href="/stylesheets/stars.css" />') %>
<% block('styles', '<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />') %>
<% block('scripts', '<script src="/vendor/leaflet-1.9.4/leaflet.js"></script>') %>
<% block('scripts', '<script src="/js/campMap.js"></script>') %>

<div class="responsive__column row mt-5">
  <div class="col-lg-6 col-sm-10">
    <% if (!camp.images.length) { %>
    <%- include('../partials/noPhoto') %>
    <% } else { %>
    <div id="campCarousel" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <% camp.images.forEach((img, i) => { %>
        <% const credit = photoCredit(img); %>
        <figure class="carousel-item mb-0 <%= i === 0 ? 'active': ''%>">
          <img src="<%= imageUrl(camp, img, 1200) %>" class="d-block w-100" alt="<%= photoAlt(img, camp, i, camp.images.length) %>" />
          <% if (credit) { %>
          <figcaption class="photo-credit">
            Photo: <a href="<%= credit.page %>" rel="noopener"><%= credit.name %></a> on Unsplash
          </figcaption>
          <% } %>
        </figure>
        <% }) %>
      </div>
      <% if(camp.images.length > 1) { %>
      <button
        class="carousel-control-prev"
        type="button"
        data-bs-target="#campCarousel"
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
      </button>
      <button
        class="carousel-control-next"
        type="button"
        data-bs-target="#campCarousel"
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
      </button>
      <% } %>
    </div>
    <% } %>
    <div class="card mt-3 mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= camp.title%></h5>
        <% if (isSample(camp)) { %>
        <p class="mb-2"><span class="badge badge-sample">Sample listing</span></p>
        <% } %>
        <p class="card-text"><%= camp.description%></p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item text-muted"><%= camp.location%></li>
        <li class="list-group-item">$<%= camp.price%>/night</li>
      </ul>
      <% if(user && sameId(camp.author, user)) { %>
      <div class="card-body d-flex justify-content-between">
        <a class="card-link btn btn-info" href="/camps/<%=camp._id%>/edit"
          >Edit camp</a
        >
        <form
          class="d-inline"
          action="/camps/<%=camp._id%>?_method=DELETE"
          method="POST"
          data-confirm="Are you sure you want to delete this camp?"
        >
          <button class="btn btn-danger">Delete camp</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>
  <div class="col-lg-6 col-sm-10">
    <div class="mb-5 card" id="map"></div>
    <% if(user) { %>
    <h2 class="text-white">Leave a review</h2>
    <form
      action="/camps/<%=camp._id%>/reviews"
      method="POST"
      class="mb-3 validForm"
      novalidate
    >
      <div class="mt-3 mb-3 star__bg">
        <fieldset class="starability-basic">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="0"
            checked
            aria-label="No rating."
          />
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div class="mb-3">
        <label class="form-label text-white" for="body">Review</label>
        <textarea
          class="form-control"
          name="review[body]"
          id="body"
          cols="30"
          rows="3"
          required
        ></textarea>
      </div>
      <button class="btn btn-success">Post review</button>
    </form>
    <% } %>
    <% if (!camp.reviews.length) { %>
    <div class="reviews-empty">
      <p class="mb-2">No reviews yet. Be the first to leave one.</p>
      <% if (!user) { %>
      <a class="btn btn-success" href="/login">Log in to leave a review</a>
      <% } %>
    </div>
    <% } %>
    <% if (isSample(camp) && camp.reviews.length) { %>
    <p class="sample-note">Reviews on sample listings are test entries.</p>
    <% } %>
    <% for(let review of camp.reviews) { %>
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title"><%= displayName(review.author) %></h5>
        <p
          class="card-subtitle mb-2 starability-result"
          data-rating="<%= review.rating %>"
        >
          Rated: <%= review.rating %> stars
        </p>

        <p class="card-text"><%= review.body %></p>
        <% if(user && sameId(review.author, user)) { %>
        <form
          action="/camps/<%=camp._id%>/reviews/<%=review._id%>?_method=DELETE"
          method="POST"
        >
          <div class="d-flex justify-content-end">
            <button class="btn btn-sm btn-danger">Delete review</button>
          </div>
        </form>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script type="application/json" id="camp-data"><%- safeJson(mapPoint(camp)) %></script>

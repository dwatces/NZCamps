<% layout('layouts/boilerplate') %>
<% block('bodyClass', 'd-flex flex-column background__color') %>
<% block('styles', '<link rel="stylesheet" href="/stylesheets/stars.css" />') %>
<% block('styles', '<link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />') %>
<% block('styles', '<link rel="stylesheet" href="/vendor/leaflet.markercluster-1.5.3/MarkerCluster.css" />') %>
<% block('styles', '<link rel="stylesheet" href="/vendor/leaflet.markercluster-1.5.3/MarkerCluster.Default.css" />') %>
<% block('scripts', '<script src="/vendor/leaflet-1.9.4/leaflet.js"></script>') %>
<% block('scripts', '<script src="/vendor/leaflet.markercluster-1.5.3/leaflet.markercluster.js"></script>') %>
<% block('scripts', '<script src="/js/clusterMap.js"></script>') %>
<div class="mt-5">
  <h1 class="text-center text-white">Explore camps</h1>
</div>
<% if(!user) { %>
<div class="mt-4 text-center">
  <p class="text-white mb-2">Sign up or log in to add camps and leave reviews.</p>
  <div class="mb-3 d-flex justify-content-center gap-4">
    <a class="btn btn-success btn-fixed" href="/register">Sign up</a>
    <a class="btn btn-light btn-fixed" href="/login">Log in</a>
  </div>
</div>
<% } else { %>
<div class="mt-4 text-center">
  <div class="mb-3 d-flex justify-content-center">
    <a class="btn btn-success" href="/camps/new">Add a camp</a>
  </div>
</div>
<% } %>
<div id="cluster-map"></div>
<div class="mb-5"></div>
<% for (let camp of camps) { %>
<div class="card mb-3">
  <div class="row">
    <div class="col-md-4">
      <% if(camp.images.length) { %>
      <img class="img-fluid" src="<%= imageUrl(camp, camp.images[0], 800) %>" alt="<%= photoAlt(camp.images[0], camp) %>" />
      <% } else { %>
      <%- include('../partials/noPhoto') %>
      <% } %>
    </div>
    <div class="col-md-8">
      <div class="card-body d-flex flex-column h-100">
        <h5 class="card-title"><%= camp.title %></h5>
        <% if (isSample(camp)) { %>
        <p class="mb-2"><span class="badge badge-sample">Sample listing</span></p>
        <% } %>
        <p class="card-text">
          <small class="text-muted"><%= camp.location %></small>
        </p>
        <p class="card-text"><%= camp.description %></p>
        <div class="mt-auto">
          <% const latest = camp.reviews[camp.reviews.length - 1]; %>
          <% if (!latest) { %>
          <h6 class="card-title">No Reviews Yet</h6>
          <% } else { %>
          <h6 class="card-title">Latest Review:</h6>
          <p class="starability-result" data-rating="<%= latest.rating %>"></p>
          <% } %>
          <div class="mt-4">
            <a class="btn btn-info text-white" href="/camps/<%=camp._id%>"
              >View <%=camp.title%></a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%}%>
<script type="application/json" id="camps-data"><%- safeJson(mapPoints(camps)) %></script>

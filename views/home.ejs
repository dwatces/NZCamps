<% layout('layouts/boilerplate') %>
<% block('bodyClass', 'home-page') %>
<% block('mainClass', 'home') %>
<% block('pageClass', 'home__inner') %>
<% const portrait = imageSet('hero.portrait'); %>
<% const wide = imageSet('hero.wide'); %>
<%# The gravel path photo: a portrait crop on portrait screens, a wide crop
    elsewhere, AVIF first. No preload: the browser finds this <img> early
    and fetchpriority puts it first. %>
<picture class="home__photo">
  <source media="(orientation: portrait)" type="image/avif" srcset="<%= portrait.avif %>" sizes="100vw" />
  <source media="(orientation: portrait)" srcset="<%= portrait.jpeg %>" sizes="100vw" />
  <source type="image/avif" srcset="<%= wide.avif %>" sizes="100vw" />
  <img
    src="<%= wide.src %>"
    srcset="<%= wide.jpeg %>"
    sizes="100vw"
    width="1920"
    height="1200"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
</picture>
<div class="home__content">
  <h1 class="home__title"><span class="text-nowrap">New Zealand</span> Camps</h1>
  <p class="home__lead">Find and review campgrounds around Aotearoa.</p>
  <div class="home__actions">
    <a href="/camps" class="btn btn-primary btn-lg home__button">View Camps</a>
    <% if (user) { %>
    <a class="home__link" href="/camps/new">Add a camp</a>
    <% } else { %>
    <a class="home__link" href="/register">Sign up to add a camp</a>
    <% } %>
  </div>
</div>
